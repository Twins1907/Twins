# --- Core ---------------------------------------------------------------
# Telegram bot token from @BotFather
GIFTPULSE_BOT_TOKEN=
# Channel the alert dispatcher posts to. Numeric id (-100...) or @username.
GIFTPULSE_ALERT_CHANNEL=

# --- Storage ------------------------------------------------------------
# SQLite by default; swap for postgresql+asyncpg://user:pass@host/db at scale.
GIFTPULSE_DATABASE_URL=sqlite+aiosqlite:///./giftpulse.db

# --- Mini App -----------------------------------------------------------
# Public HTTPS origin serving the Mini App + API (must match the BotFather URL).
GIFTPULSE_PUBLIC_URL=http://localhost:8080
GIFTPULSE_API_HOST=0.0.0.0
GIFTPULSE_API_PORT=8080

# --- Indexer ------------------------------------------------------------
GIFTPULSE_POLL_INTERVAL_SECONDS=60
# Comma-separated venue slugs to poll. Available: portals,tonnel,mrkt
GIFTPULSE_ENABLED_VENUES=portals,tonnel,mrkt
# Run against deterministic synthetic data. No network, no credentials.
GIFTPULSE_MOCK=true

# --- Venue credentials --------------------------------------------------
# Portals: short-lived authData string captured from the Telegram Web client.
GIFTPULSE_PORTALS_AUTH_DATA=
GIFTPULSE_PORTALS_REFERRAL=
# Tonnel: open API, referral code only.
GIFTPULSE_TONNEL_REFERRAL=
GIFTPULSE_MRKT_REFERRAL=

# --- Monetization -------------------------------------------------------
# Thin execution fee in basis points, applied on top of referral routing.
# 0 = referral-only (day one). 50 = 0.50%. 100 = 1.00%.
GIFTPULSE_EXECUTION_FEE_BPS=0
# TON address that collects the execution fee. Never a private key.
GIFTPULSE_FEE_WALLET=

# --- Alert thresholds ---------------------------------------------------
GIFTPULSE_FLOOR_BREAK_PCT=5.0
GIFTPULSE_SPREAD_ALERT_PCT=8.0
GIFTPULSE_WHALE_MIN_TON=500.0
