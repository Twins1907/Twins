# Copy to .env and fill in. Keep it out of git and off shared disks:
#
#     cp .env.example .env && chmod 600 .env
#
# This file names no private key, seed phrase, or wallet secret, and none should
# ever be added. GiftPulse is routing-only — the user signs in their own wallet.

# --- Core ---------------------------------------------------------------
# Telegram bot token from @BotFather
GIFTPULSE_BOT_TOKEN=
# Channel the alert dispatcher posts to. Numeric id (-100...) or @username.
GIFTPULSE_ALERT_CHANNEL=
# Chat that receives operational notices: stalled indexer, rejected credentials.
# Your own user id is fine. Without it, those failures are silent.
GIFTPULSE_ADMIN_CHAT_ID=

# --- Storage ------------------------------------------------------------
# SQLite is fine for one process. `giftpulse all` runs the indexer and API
# together and both write, so use Postgres for anything real:
#   postgresql+asyncpg://giftpulse:PASSWORD@db:5432/giftpulse
GIFTPULSE_DATABASE_URL=sqlite+aiosqlite:///./giftpulse.db
# Apply migrations on startup. Turn off if a separate release step runs
# `giftpulse migrate` itself.
GIFTPULSE_AUTO_MIGRATE=true
# Snapshots, sales, and alert history older than this are pruned hourly. The
# indexer writes ~35k snapshot rows a day, so this is not optional at scale.
GIFTPULSE_RETENTION_DAYS=45

# Password for the bundled Postgres in docker-compose. No default on purpose.
POSTGRES_PASSWORD=

# --- Mini App -----------------------------------------------------------
# Public HTTPS origin serving the Mini App + API. Must match the BotFather URL
# exactly. Telegram will not open a Mini App over plain HTTP.
GIFTPULSE_PUBLIC_URL=http://localhost:8080
GIFTPULSE_API_HOST=0.0.0.0
GIFTPULSE_API_PORT=8080
# Hostname Caddy requests a certificate for (docker compose --profile tls).
GIFTPULSE_DOMAIN=

# --- Indexer ------------------------------------------------------------
GIFTPULSE_POLL_INTERVAL_SECONDS=60
# Comma-separated venue slugs to poll. Available: portals,tonnel,mrkt
GIFTPULSE_ENABLED_VENUES=portals,tonnel,mrkt
# Run against deterministic synthetic data. No network, no credentials.
# Set false once you have validated the adapters against the live APIs.
GIFTPULSE_MOCK=true
# Spread polls across a window instead of hitting every venue on the same second
# of every minute. 0.15 = +/-15%.
GIFTPULSE_POLL_JITTER_PCT=0.15
# Sustained request ceiling per venue, across the whole process.
GIFTPULSE_VENUE_MAX_RPS=2.0
GIFTPULSE_VENUE_MAX_RETRIES=3
# No successful cycle in this long means /api/health reports degraded.
GIFTPULSE_CYCLE_STALL_SECONDS=600

# --- Venue credentials --------------------------------------------------
# Portals: short-lived authData string captured from the Telegram Web client.
# It expires in hours, not days. When it does, the venue goes dark and the
# admin chat gets one message.
GIFTPULSE_PORTALS_AUTH_DATA=
GIFTPULSE_PORTALS_REFERRAL=
# Tonnel: open API, referral code only.
GIFTPULSE_TONNEL_REFERRAL=
GIFTPULSE_MRKT_REFERRAL=

# --- Monetization -------------------------------------------------------
# Thin execution fee in basis points, applied on top of referral routing.
# 0 = referral-only (day one). 50 = 0.50%. 100 = 1.00%.
GIFTPULSE_EXECUTION_FEE_BPS=0
# TON address that collects the execution fee. A public address — never a key.
GIFTPULSE_FEE_WALLET=

# --- Alert thresholds ---------------------------------------------------
# Tune these against real data before pointing the dispatcher at a public
# channel. The defaults are guesses against synthetic prices.
GIFTPULSE_FLOOR_BREAK_PCT=5.0
GIFTPULSE_SPREAD_ALERT_PCT=8.0
GIFTPULSE_WHALE_MIN_TON=500.0
# Suppresses a repeat of the same event.
GIFTPULSE_ALERT_COOLDOWN_SECONDS=900
# Hard ceiling on channel posts per hour, across all events. The single most
# important number for retention: one spammy hour costs subscribers for good.
GIFTPULSE_ALERT_MAX_PER_HOUR=12
# A delta needs a baseline at least this old to count. Stops a fresh deployment
# alerting off 60-second noise.
GIFTPULSE_ALERT_MIN_BASELINE_MINUTES=20

# --- API ----------------------------------------------------------------
# /api/quote fans out to every venue, so it is where one user can become a
# venue-side rate-limit problem. Per user, per API worker.
GIFTPULSE_QUOTE_RATE_LIMIT_PER_MINUTE=20
